# Supabase → Project Settings → API. Both are safe to expose to the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (no NEXT_PUBLIC_ prefix, so never sent to the browser).
# Packaged-food search needs both; without them it shows a setup note.
# Free key: https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=your-fdc-api-key
# Supabase Secret key (sb_secret_...). Used only to save USDA packaged foods
# into the shared foods table, which signed-in users can't write to.
SUPABASE_SECRET_KEY=your-secret-key
